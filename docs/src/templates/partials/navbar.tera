{% import "macros.tera" as nav %}
<header class="navbar">
    <div class="navbar-inner">
        <a href="/" class="brand">{{ site.site_name }}</a>
        <button class="navbar-toggle" aria-label="Toggle navigation" id="navbar-toggle">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <nav class="nav-links" id="nav-links">
            {{ nav::render_nav(items=site.navbar, active_url=page_url | default(value='')) }}
        </nav>
    </div>
</header>